{
    "version": 3,
    "configurePresets": [
		{
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vendor/vcpkg/scripts/buildsystems/vcpkg.cmake", 
				"CMAKE_C_COMPILER_WORKS": "1", 
				"CMAKE_CXX_COMPILER_WORKS": "1"
            }
		},
        {
            "name": "windows-base",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe",
				"CMAKE_CXX_FLAGS": "/DWINDOWS_PLATFORM /GS- /Gs1000000000 /GR- /Gm- /EHa-",
				"CMAKE_EXE_LINKER_FLAGS": "/SUBSYSTEM:CONSOLE /NODEFAULTLIB /stack:0x200000,200000 /INCREMENTAL:NO", 
				"CMAKE_STATIC_LINKER_FLAGS": "/NODEFAULTLIB", 
				"CMAKE_SHARED_LINKER_FLAGS": "/NODEFAULTLIB /INCREMENTAL:NO", 
				"CMAKE_CXX_STANDARD_LIBRARIES": "", 
				"CMAKE_CXX_STANDARD": "23"

            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
				"CMAKE_CXX_FLAGS": "-DLINUX_PLATFORM"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-base",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
				"CMAKE_CXX_FLAGS": "-DMACOS_PLATFORM"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug", 
				"CMAKE_CXX_FLAGS_DEBUG": "/DDEBUG_BUILD /Zi",
				"CMAKE_EXE_LINKER_FLAGS_DEBUG": "/DEBUG:FULL",
				"CMAKE_STATIC_LINKER_FLAGS_DEBUG": "",
				"CMAKE_SHARED_LINKER_FLAGS_DEBUG": "/DEBUG:FULL"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
				"CMAKE_CXX_FLAGS_RELEASE": "/DRELEASE_BUILD",
				"CMAKE_EXE_LINKER_FLAGS_RELEASE": "",
				"CMAKE_STATIC_LINKER_FLAGS_RELEASE": "",
				"CMAKE_SHARED_LINKER_FLAGS_RELEASE": ""
            }
        },
        {
            "name": "windows-internal",
            "displayName": "Windows Internal",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/DDEBUG_BUILD /Zi",
				"CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG:FULL",
				"CMAKE_STATIC_LINKER_FLAGS_RELWITHDEBINFO": "",
				"CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG:FULL"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-internal",
            "displayName": "Linux Internal",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS Release",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos-internal",
            "displayName": "macOS Internal",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ]
}

